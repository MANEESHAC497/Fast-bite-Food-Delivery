<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FastBite - Food Delivery</title>

<style>
* {
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body {
  font-family:Arial,sans-serif;
  background:#fffaf5;
  color:#333;
}

header {
  background:#fc4f24;
  color:white;
  padding:18px;
}

nav {
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:15px;
}

.logo {
  font-size:27px;
  font-weight:bold;
}

nav ul {
  display:flex;
  list-style:none;
  gap:18px;
  flex-wrap:wrap;
}

nav a {
  color:white;
  text-decoration:none;
  font-weight:bold;
}

button {
  background:#fc4f24;
  color:white;
  border:none;
  padding:11px 17px;
  border-radius:7px;
  cursor:pointer;
  font-weight:bold;
}

button:hover {
  background:#d93b16;
}

.cart-btn {
  background:white;
  color:#fc4f24;
}

.hero {
  text-align:center;
  padding:75px 15px;
  color:white;
  background:linear-gradient(#0008,#0008),
  url("https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200")
  center/cover;
}

.hero h1 {
  font-size:38px;
  margin-bottom:15px;
}

.hero p {
  font-size:19px;
  margin-bottom:20px;
}

.search-box {
  text-align:center;
  padding:25px 15px;
}

.search-box input {
  width:90%;
  max-width:500px;
  padding:14px;
  border:1px solid #ccc;
  border-radius:8px;
  font-size:16px;
}

.section {
  padding:35px 20px;
  text-align:center;
}

.section h2 {
  margin-bottom:25px;
  font-size:28px;
}

.categories {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:25px;
}

.categories button {
  border-radius:25px;
}

.restaurant-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  max-width:1100px;
  margin:auto;
}

.card {
  background:white;
  border-radius:12px;
  overflow:hidden;
  box-shadow:0 3px 12px #0002;
  padding-bottom:18px;
}

.card img {
  width:100%;
  height:180px;
  object-fit:cover;
}

.card h3 {
  margin:14px;
}

.card p {
  margin:10px;
}

.rating {
  color:green;
  font-weight:bold;
}

.deals {
  background:#ffe1d4;
  padding:35px;
  text-align:center;
}

.deals h2 {
  margin-bottom:15px;
}

.modal {
  display:none;
  position:fixed;
  inset:0;
  background:#0009;
  z-index:30;
  overflow-y:auto;
  padding:20px;
}

.modal-content {
  background:white;
  max-width:500px;
  margin:25px auto;
  padding:22px;
  border-radius:12px;
}

.close {
  float:right;
  font-size:27px;
  cursor:pointer;
}

.menu-item {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:15px 0;
  border-bottom:1px solid #ddd;
  text-align:left;
}

.menu-item p {
  margin-top:7px;
}

.cart {
  display:none;
  position:fixed;
  right:0;
  top:0;
  height:100%;
  width:350px;
  max-width:95%;
  background:white;
  z-index:40;
  padding:22px;
  box-shadow:-3px 0 10px #0003;
  overflow-y:auto;
}

.cart h2 {
  margin:20px 0;
}

.cart-item {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  margin-bottom:15px;
  border-bottom:1px solid #ddd;
  padding-bottom:10px;
}

.cart-item button {
  padding:5px 9px;
}

.cart-total {
  margin-top:20px;
}

.checkout-form input,
.checkout-form textarea {
  width:100%;
  padding:12px;
  margin:8px 0;
  border:1px solid #ccc;
  border-radius:6px;
}

footer {
  background:#222;
  color:white;
  padding:30px;
  text-align:center;
  margin-top:30px;
}

footer p {
  margin:10px;
}

@media(max-width:768px) {
  .restaurant-grid {
    grid-template-columns:1fr;
  }

  .hero h1 {
    font-size:27px;
  }

  nav {
    justify-content:center;
  }

  nav ul {
    justify-content:center;
  }
}
</style>
</head>

<body>

<header>
<nav>
<div class="logo">🍔 FastBite</div>
<ul>
<li><a href="#home">Home</a></li>
<li><a href="#restaurants">Restaurants</a></li>
<li><a href="#deals">Offers</a></li>
<li><a href="#contact">Contact</a></li>
<li>
<button class="cart-btn" onclick="openCart()">
🛒 Cart (<span id="count">0</span>)
</button>
</li>
</ul>
</nav>
</header>

<section class="hero" id="home">
<h1>Order Delicious Food Online!</h1>
<p>Fresh Food Delivered To Your Doorstep 🚴</p>
<p>Get 20% OFF - Use FASTBITE20</p>
<button onclick="document.getElementById('restaurants').scrollIntoView()">
Order Now
</button>
</section>

<div class="search-box">
<input type="text" id="search"
placeholder="🔍 Search restaurants or food..."
oninput="showRestaurants()">
</div>

<section class="section" id="restaurants">
<h2>🍽️ Popular Restaurants</h2>

<div class="categories">
<button onclick="filterType('All')">All</button>
<button onclick="filterType('Veg')">🥗 Veg</button>
<button onclick="filterType('Non-Veg')">🍗 Non-Veg</button>
</div>

<div class="restaurant-grid" id="restaurant-list"></div>
</section>

<section class="deals" id="deals">
<h2>🎉 Special Offers</h2>
<p>Get 20% OFF on your first order!</p>
<br>
<strong>Coupon Code: FASTBITE20</strong>
</section>

<div class="modal" id="menu-modal">
<div class="modal-content">
<span class="close" onclick="closeMenu()">×</span>
<h2 id="menu-title">Restaurant Menu</h2>
<div id="menu-items"></div>
</div>
</div>

<div class="cart" id="cart">
<span class="close" onclick="closeCart()">×</span>
<h2>🛒 Your Cart</h2>

<div id="cart-items"></div>

<div class="cart-total">
<p>Subtotal: ₹<span id="subtotal">0</span></p>
<p>Discount: ₹<span id="discount">0</span></p>
<h3>Total: ₹<span id="total">0</span></h3>
</div>

<br>
<button onclick="checkout()">Place Order</button>
</div>

<div class="modal" id="checkout-modal">
<div class="modal-content">
<span class="close" onclick="closeCheckout()">×</span>
<h2>📦 Delivery Details</h2>
<div class="checkout-form">
<input id="customer-name" placeholder="Your Name">
<input id="customer-phone" type="tel" placeholder="Phone Number">
<textarea id="customer-address" placeholder="Delivery Address"></textarea>
<button onclick="placeOrder()">Confirm Order</button>
</div>
</div>
</div>

<footer id="contact">
<h2>🍔 FastBite Food Delivery</h2>
<p>📞 9876543210</p>
<p>📧 hello@fastbite.com</p>
<p>© 2026 FastBite. All Rights Reserved.</p>
</footer>

<script>

const restaurants = [
{
name:"Burger Shack",
type:"Non-Veg",
rating:"4.5",
image:"https://images.unsplash.com/photo-1571091718767-18b5b1457add?w=600",
menu:[
{name:"Classic Burger",price:199},
{name:"Cheese Burger",price:249},
{name:"Chicken Burger",price:279},
{name:"French Fries",price:99},
{name:"Chicken Nuggets",price:179},
{name:"Veg Burger",price:149}
]
},
{
name:"Pizza House",
type:"Veg",
rating:"4.7",
image:"https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600",
menu:[
{name:"Margherita Pizza",price:299},
{name:"Cheese Pizza",price:349},
{name:"Veg Pizza",price:249},
{name:"Paneer Pizza",price:329},
{name:"Garlic Bread",price:129},
{name:"Pasta",price:199}
]
},
{
name:"Spice Kitchen",
type:"Non-Veg",
rating:"4.8",
image:"https://images.unsplash.com/photo-1512058564366-18510be2db19?w=600",
menu:[
{name:"Chicken Biryani",price:220},
{name:"Veg Biryani",price:160},
{name:"Beef Biryani",price:250},
{name:"Fried Rice",price:180},
{name:"Chicken Curry",price:200},
{name:"Porotta",price:15}
]
},
{
name:"Green Garden",
type:"Veg",
rating:"4.4",
image:"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=600",
menu:[
{name:"Veg Salad",price:120},
{name:"Paneer Curry",price:190},
{name:"Veg Meals",price:140},
{name:"Masala Dosa",price:80},
{name:"Idli",price:40},
{name:"Gobi Manchurian",price:150}
]
},
{
name:"Chicken Corner",
type:"Non-Veg",
rating:"4.6",
image:"https://images.unsplash.com/photo-1532550907401-a500c9a57435?w=600",
menu:[
{name:"Grilled Chicken",price:350},
{name:"Shawarma",price:130},
{name:"Chicken 65",price:220},
{name:"Al Faham",price:320},
{name:"Chicken Roll",price:120},
{name:"Fried Chicken",price:250}
]
},
{
name:"Sweet Treats",
type:"Veg",
rating:"4.3",
image:"https://images.unsplash.com/photo-1563805042-7684c019e1cb?w=600",
menu:[
{name:"Chocolate Cake",price:120},
{name:"Ice Cream",price:80},
{name:"Brownie",price:100},
{name:"Donut",price:70},
{name:"Milkshake",price:110},
{name:"Fruit Salad",price:90}
]
}
];

let cartItems = [];
let currentFilter = "All";

function showRestaurants() {
let search = document.getElementById("search").value.toLowerCase();

let filtered = restaurants.filter(r => {
let matchesType = currentFilter === "All" || r.type === currentFilter;
let matchesSearch = r.name.toLowerCase().includes(search) ||
r.menu.some(item => item.name.toLowerCase().includes(search));
return matchesType && matchesSearch;
});

let html = "";

filtered.forEach((r) => {
let index = restaurants.indexOf(r);
html += `
<div class="card">
<img src="${r.image}" alt="${r.name}">
<h3>${r.name}</h3>
<p class="rating">⭐ ${r.rating} | ${r.type}</p>
<button onclick="openMenu(${index})">View Menu</button>
</div>`;
});

document.getElementById("restaurant-list").innerHTML =
html || "<p>No restaurants found!</p>";
}

function filterType(type) {
currentFilter = type;
showRestaurants();
}

function openMenu(index) {
let restaurant = restaurants[index];

document.getElementById("menu-title").textContent =
restaurant.name + " Menu";

let html = "";

restaurant.menu.forEach(item => {
html += `
<div class="menu-item">
<div>
<h3>${item.name}</h3>
<p>₹${item.price}</p>
</div>
<button onclick="addToCart('${item.name}',${item.price})">
+ Add
</button>
</div>`;
});

document.getElementById("menu-items").innerHTML = html;
document.getElementById("menu-modal").style.display = "block";
}

function closeMenu() {
document.getElementById("menu-modal").style.display = "none";
}

function addToCart(name,price) {
let existing = cartItems.find(item => item.name === name);

if(existing) {
existing.qty++;
} else {
cartItems.push({name,price,qty:1});
}

updateCart();
alert(name + " added to cart!");
}

function updateCart() {
let html = "";
let subtotal = 0;
let count = 0;

cartItems.forEach((item,index) => {
subtotal += item.price * item.qty;
count += item.qty;

html += `
<div class="cart-item">
<div>
<strong>${item.name}</strong>
<p>₹${item.price} × ${item.qty}</p>
<button onclick="changeQty(${index},-1)">−</button>
<button onclick="changeQty(${index},1)">+</button>
</div>
<button onclick="removeItem(${index})">X</button>
</div>`;
});

let discount = subtotal >= 500 ? subtotal * 0.20 : 0;
let total = subtotal - discount;

document.getElementById("cart-items").innerHTML =
html || "<p>Your cart is empty.</p>";

document.getElementById("count").textContent = count;
document.getElementById("subtotal").textContent = subtotal.toFixed(2);
document.getElementById("discount").textContent = discount.toFixed(2);
document.getElementById("total").textContent = total.toFixed(2);
}

function changeQty(index,change) {
cartItems[index].qty += change;

if(cartItems[index].qty <= 0) {
cartItems.splice(index,1);
}

updateCart();
}

function removeItem(index) {
cartItems.splice(index,1);
updateCart();
}

function openCart() {
document.getElementById("cart").style.display = "block";
}

function closeCart() {
document.getElementById("cart").style.display = "none";
}

function checkout() {
if(cartItems.length === 0) {
alert("Your cart is empty!");
return;
}

closeCart();
document.getElementById("checkout-modal").style.display = "block";
}

function closeCheckout() {
document.getElementById("checkout-modal").style.display = "none";
}

function placeOrder() {
let name = document.getElementById("customer-name").value.trim();
let phone = document.getElementById("customer-phone").value.trim();
let address = document.getElementById("customer-address").value.trim();

if(!name || !phone || !address) {
alert("Please fill all delivery details!");
return;
}

if(!/^[0-9]{10}$/.test(phone)) {
alert("Please enter a valid 10-digit phone number!");
return;
}

let orderNumber = Math.floor(10000 + Math.random() * 90000);

alert("Order placed successfully! 🎉\nOrder ID: " + orderNumber +
"\nThank you, " + name + "!");

cartItems = [];
updateCart();
closeCheckout();

document.getElementById("customer-name").value = "";
document.getElementById("customer-phone").value = "";
document.getElementById("customer-address").value = "";
}

showRestaurants();
updateCart();

</script>

</body>
</html>


